# Local database only; use a dedicated Supabase connection in production.
DATABASE_URL=postgres://truck:truck@127.0.0.1:5432/truck_tracker
PORT=8787
NODE_ENV=development
SESSION_SECRET=dev-session-secret-change-me
FRONTEND_ORIGIN=http://localhost:5173

# Production requires a verified sender and working Resend key.
MAIL_FROM=Truck Tracker <noreply@localhost>
# RESEND_API_KEY=

# Set unique passwords (12+ characters) before running npm run seed.
PLATFORM_ADMIN_EMAIL=platform@example.com
PLATFORM_ADMIN_PASSWORD=
SEED_ORGANIZER_EMAIL=organizer@example.com
SEED_ORGANIZER_PASSWORD=
SEED_BAND_SLUG=tobago-carnival
SEED_BAND_NAME=Tobago Carnival

# Unset for the local mock demo. Set for the 1.2 API and phone GPS.
VITE_API_URL=http://127.0.0.1:8787/api

# Client skin. Any id registered in src/config/clients.ts. Unset = original.
# VITE_BRAND=fog-angels

# Optional seed presentation. Unset = original. Use apply-brand to rename a live band.
# SEED_BRAND=fog-angels
