{
  "name": "truck-tracker",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "build": "tsc -b && vite build && node scripts/write-service-worker.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build:live": "NODE_ENV=production VITE_API_URL=/api BASE_PATH=/ VITE_ENABLE_DEMO_ADMIN=false npm run build",
    "build:live:fog": "VITE_BRAND=fog-angels npm run build:live",
    "brand": "tsx scripts/apply-brand.ts",
    "provision-testers": "tsx scripts/provision-testers.ts",
    "load:friends": "tsx scripts/load-friends.ts",
    "live:assurance": "node scripts/live-assurance.mjs",
    "live:links": "node scripts/link-audit.mjs",
    "check": "npm run test && npm run lint",
    "check:ci": "npm run test && npm run lint && npm run build:live",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "dotenv": "^17.2.3",
    "hono": "^4.11.4",
    "maplibre-gl": "^6.8.0",
    "postgres": "^3.4.7",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
